# Copy this file to .env and fill in your keys. NEVER commit .env to GitHub.

# Alpaca keys (alpaca.markets -> Paper Trading -> API Keys)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# paper (default) or live. Live also requires LIVE_CONFIRM=I_ACCEPT_THE_RISK and LIVE keys.
TRADING_MODE=paper
LIVE_CONFIRM=

# Live bot data. iex = free real-time (bot auto-adjusts volume filters). sip = full market (paid plan)
# Backtests always use full-market history by default (free).
DATA_FEED=iex

# Symbols to always watch + today's most-active stocks from Alpaca's screener
WATCHLIST=SOFI,PLTR,F,NIO,RIVN,LCID,SNAP,AAL
USE_SCREENER=true

# Price range. $1-$20 = low-priced but exchange-listed. Alpaca does not trade OTC penny stocks.
MIN_PRICE=1
MAX_PRICE=20

# Risk rules
RISK_PCT=0.01
MAX_TRADES_PER_DAY=2
DAILY_LOSS_LIMIT_PCT=0.02

# Which setups run: orb, gap, or orb,gap
STRATEGIES=orb,gap

# ORB knobs
RVOL_MIN=1.5
REWARD_RISK=2.0
OR_MINUTES=15           # opening range length: 15 or 30
ORB_STOP_MODE=mid       # mid or low of the opening range
MARKET_FILTER=false     # true = only buy when SPY is above its VWAP

# Gap-and-go knobs
GAP_MIN=0.10            # 10%+ gap up
GAP_RVOL_MIN=3.0        # 3x normal volume pace
GAP_REWARD_RISK=2.0
GAP_REQUIRE_NEWS=false  # true = only gappers with news in the last 24h (live only)

# Optional: Telegram alerts to your phone (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DB_PATH=journal.db

# Auto-invest (python -m daybot.autoinvest): weekly buy of an index fund with your cash
AUTOINVEST_SYMBOL=SPY
AUTOINVEST_CASH_RESERVE=0      # dollars to always leave as cash
AUTOINVEST_MAX_PER_WEEK=500    # safety cap per weekly buy
AUTOINVEST_MIN_ORDER=1
